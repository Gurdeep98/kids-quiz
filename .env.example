# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#
# From a Google Cloud OAuth "Desktop app" client
# (console.cloud.google.com → APIs & Services → Credentials):
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret

# Obtained by running:  npm run auth
YT_REFRESH_TOKEN=your-refresh-token

# Voiceover narration (Google Cloud Text-to-Speech).
# Enable "Cloud Text-to-Speech API" in the same Google Cloud project, then
# create an API key (APIs & Services → Credentials) and restrict it to that API.
# If unset, videos render silently.
GOOGLE_TTS_API_KEY=your-tts-api-key
# Optional voice overrides:
# TTS_VOICE=en-US-Neural2-F
# TTS_RATE=1.0
